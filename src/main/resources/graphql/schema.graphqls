type Product {
  id: ID
  name: String!
  slug: String
  description: String
  sku: String
  status: String
  categories: [Category!]
  price: Price
  ranking: Ranking
  recentComments: [RecentComment!]
  hasMoreComments: Boolean
  createdAt: String
  updatedAt: String
}

input ProductInput {
  id: ID
  name: String!
  slug: String
  description: String
  sku: String
  status: String
  categories: [CategoryInput!]
  price: PriceInput!
  ranking: RankingInput
  recentComments: [RecentCommentInput!]
  hasMoreComments: Boolean
  createdAt: String
  updatedAt: String
}

type Category {
  categoryId: ID
  name: String
  slug: String
}

input CategoryInput {
  categoryId: ID
  name: String
  slug: String
}

type Price {
  current: Float
  original: Float
  currency: String
  discountPercentage: Int
  taxInclusive: Boolean
}

input PriceInput {
  current: Float
  original: Float
  currency: String
  discountPercentage: Int
  taxInclusive: Boolean
}

type Ranking {
  averageRating: Float
  totalReviews: Int
  ratingDistribution: RatingDistribution
}

input RankingInput {
  averageRating: Float
  totalReviews: Int
  ratingDistribution: RatingDistributionInput
}

type RatingDistribution {
  fiveStar: Int
  fourStar: Int
  threeStar: Int
  twoStar: Int
  oneStar: Int
}

input RatingDistributionInput {
  fiveStar: Int
  fourStar: Int
  threeStar: Int
  twoStar: Int
  oneStar: Int
}

type RecentComment {
  commentId: ID
  userId: ID
  username: String
  rating: Int
  title: String
  body: String
  createdAt: String
}

input RecentCommentInput {
  commentId: ID
  userId: ID
  username: String
  rating: Int
  title: String
  body: String
  createdAt: String
}

type Query {
  listarTodos: [Product!]!
  obtenerPorId(id: ID!): Product
}

type Mutation {
  crear(input: ProductInput!): Product!
  actualizar(id: ID!, input: ProductInput!): Product!
  eliminar(id: ID!): Boolean!
}
